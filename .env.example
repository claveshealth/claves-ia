# ===========================================================================
# Claves CRM IA — exemplo de configuracao
# Copie para `.env` e preencha. O arquivo `.env` NUNCA vai para o Git.
# ===========================================================================

# --- Obrigatorio ----------------------------------------------------------
# Chave mestra usada para cifrar as chaves de API de LLM no banco (AES-256-GCM).
# Gere com:  npm run gerar-chave
# Se voce perder esta chave, as chaves de API salvas se tornam irrecuperaveis.
APP_MASTER_KEY=

# --- Servidor -------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# URL publica da aplicacao. Em producao DEVE ser https:// — e usada para
# validacao de Origin (anti-CSRF) e para marcar o cookie como Secure.
APP_URL=http://127.0.0.1:3000

# Confiar no cabecalho X-Forwarded-For (habilite APENAS atras de um proxy
# reverso confiavel, como Nginx/Cloudflare). Se habilitar sem proxy, o
# rate limit por IP pode ser burlado.
TRUST_PROXY=false

# --- Primeiro acesso ------------------------------------------------------
# Se nao houver nenhum usuario cadastrado, estes valores criam o admin
# no primeiro boot. Depois disso podem ser removidos do .env.
# A senha precisa ter no minimo 12 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Sessao ---------------------------------------------------------------
# Tempo de inatividade ate expirar a sessao (minutos).
SESSION_TTL_MIN=480

# --- Limites --------------------------------------------------------------
# Pesquisas de leads simultaneas por usuario.
MAX_RUNS_CONCORRENTES=2
# Teto de tokens de saida por chamada ao LLM.
LLM_MAX_TOKENS=16000
